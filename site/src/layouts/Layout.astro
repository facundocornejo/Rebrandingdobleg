---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og-cover.jpg', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="Galpón de hormigón premoldeado construido por Dobleg en Entre Ríos"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <script>
      // Everything the page needs, in one place: scroll reveals, the floating
      // WhatsApp button, and the contact form. Vanilla, no dependencies.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Reveal on scroll -------------------------------------------------
      const revealable = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduced) {
        revealable.forEach((el) => el.classList.add('is-visible'));
      } else {
        const revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              revealer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        revealable.forEach((el) => revealer.observe(el));
      }

      // --- Header border ----------------------------------------------------
      const sentinel = document.querySelector('[data-header-sentinel]');
      const header = document.querySelector('[data-header]');
      if (sentinel && header) {
        new IntersectionObserver(([entry]) =>
          header.classList.toggle('is-stuck', !entry.isIntersecting)
        ).observe(sentinel);
      }

      // --- Floating WhatsApp button ----------------------------------------
      // Hidden while the contact section is on screen: down there the same
      // action already exists, and the button would just cover content.
      const fab = document.querySelector<HTMLElement>('[data-fab]');
      const contacto = document.getElementById('contacto');
      if (fab && contacto) {
        new IntersectionObserver(
          ([entry]) => fab.classList.toggle('is-hidden', entry.isIntersecting),
          { threshold: 0.15 }
        ).observe(contacto);
      }

      // --- Contact form -----------------------------------------------------
      // Progressive enhancement: without JS the form posts natively to
      // Formspree and its confirmation page takes over.
      const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
      if (form) {
        const status = form.querySelector<HTMLElement>('[data-form-status]');
        const submit = form.querySelector<HTMLButtonElement>('[data-form-submit]');
        const done = document.querySelector<HTMLElement>('[data-form-done]');
        const fallback = form.querySelector<HTMLElement>('[data-form-fallback]');
        const fallbackLink = form.querySelector<HTMLAnchorElement>('[data-form-fallback-link]');
        const waNumber = form.dataset.whatsapp ?? '';

        const setStatus = (message: string, tone: 'error' | 'info') => {
          if (!status) return;
          status.textContent = message;
          status.dataset.tone = tone;
          status.hidden = !message;
        };

        form.addEventListener('submit', async (event) => {
          if (!form.reportValidity()) return;
          event.preventDefault();

          const data = new FormData(form);
          submit?.setAttribute('disabled', '');
          form.classList.add('is-sending');
          setStatus('Enviando tu consulta…', 'info');
          fallback?.setAttribute('hidden', '');

          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 10_000);

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: data,
              headers: { Accept: 'application/json' },
              signal: controller.signal,
            });
            if (!response.ok) throw new Error(String(response.status));

            form.hidden = true;
            if (done) done.hidden = false;
            done?.focus();
          } catch {
            // The values stay in the fields on purpose: retyping everything is
            // the fastest way to lose a lead.
            setStatus(
              'No pudimos enviar el formulario. Probá de nuevo o escribinos por WhatsApp.',
              'error'
            );
            if (fallbackLink && waNumber) {
              const text = [
                `Hola! Soy ${data.get('nombre') ?? ''}.`,
                data.get('producto') ? `Consulto por: ${data.get('producto')}.` : '',
                data.get('mensaje') ?? '',
                data.get('telefono') ? `Mi teléfono: ${data.get('telefono')}` : '',
              ]
                .filter(Boolean)
                .join(' ');
              fallbackLink.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
              fallback?.removeAttribute('hidden');
            }
          } finally {
            clearTimeout(timeout);
            submit?.removeAttribute('disabled');
            form.classList.remove('is-sending');
          }
        });
      }
    </script>
  </body>
</html>
