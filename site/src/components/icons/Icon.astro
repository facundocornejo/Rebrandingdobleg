---
/**
 * Inline SVG icons. Kept in one file so every glyph shares the same viewBox,
 * stroke width and cap style — the legacy site pulled all of Font Awesome for
 * a handful of shapes.
 *
 * All icons are line drawings on `currentColor`, except `whatsapp`, which is a
 * solid brand glyph.
 */
export type IconName =
  | 'whatsapp'
  | 'check'
  | 'arrow-down'
  | 'phone'
  | 'mail'
  | 'instagram'
  | 'facebook'
  | 'clock'
  | 'map-pin'
  | 'wrench'
  | 'chat'
  | 'receipt';

interface Props {
  name: IconName;
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const solid = name === 'whatsapp' || name === 'instagram' || name === 'facebook';
---

