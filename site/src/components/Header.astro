---
import { Image } from 'astro:assets';

import { site, whatsappUrl } from '../data/site';
import logo from '../assets/logo-dobleg.webp';
import Icon from './icons/Icon.astro';

const links = [
  { href: '#productos', label: 'Productos' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#preguntas', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];
---

{/* Sentinel: while it is on screen the page is at the top, so the header
    stays borderless. Cheaper than a scroll listener. */}
<div data-header-sentinel aria-hidden="true"></div>

<header class="site-header" data-header>
  <div class="container-page site-header__inner">
    <a href="#inicio" class="site-header__brand" aria-label={`${site.name}, inicio`}>
      <Image src={logo} alt={site.name} widths={[180, 360]} width={180} sizes="118px" loading="eager" />
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a class="btn btn--cta btn--sm" href={whatsappUrl('Hola! Quiero hacer una consulta')}>
      <Icon name="whatsapp" size={20} />
      WhatsApp
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease-out;
  }

  .site-header.is-stuck {
    border-bottom-color: var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    min-height: 64px;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
  }

  .site-header__brand img {
    width: 118px;
    height: auto;
  }

  /* No hamburger: below 1024px the header is just brand + the one action that
     matters, and the sections are one scroll away. */
  .site-header__nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: flex;
      gap: var(--spacing-lg);
    }

    .site-header__nav a {
      font-weight: 500;
      color: var(--color-text);
      text-decoration: none;
      padding-block: var(--spacing-xs);
    }

    .site-header__nav a:hover {
      color: var(--color-brand);
    }
  }
</style>
